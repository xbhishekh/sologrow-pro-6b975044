# Copy to /etc/smmpanel.secrets  &&  chmod 600 /etc/smmpanel.secrets
# ---- App / VPS ----
APP_DOMAIN=example.com
APP_DIR=/opt/smmpanel
REPO_URL=https://github.com/USER/REPO.git
REPO_BRANCH=main
GITHUB_TOKEN=

# ---- Self-hosted Supabase ----
SUPABASE_DIR=/opt/supabase
POSTGRES_PASSWORD=change-me-strong
POSTGRES_PORT=5433
JWT_SECRET=change-me-at-least-32-chars-long-secret
ANON_KEY=
SERVICE_ROLE_KEY=
SITE_URL=https://example.com
API_EXTERNAL_URL=https://example.com

# ---- Cloud (source) Supabase, sirf migration ke waqt ----
CLOUD_DB_URL=postgresql://postgres:PASS@db.PROJECTREF.supabase.co:5432/postgres
CLOUD_PROJECT_REF=
CLOUD_SERVICE_ROLE_KEY=

# ---- Provider / app secrets (edge functions) ----
ZAPUPI_TOKEN=
ZAPUPI_SECRET=
OXAPAY_MERCHANT_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
RESEND_API_KEY=
LOVABLE_API_KEY=
